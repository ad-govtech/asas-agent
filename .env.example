# Agent registry
DATABASE_URL=postgresql://user@localhost:5432/asas_agent
ASAS_ENVIRONMENT=dev

# Runtime API. Callers send it as `X-API-Key`.
ASAS_API_KEY=
ASAS_PORT=8080

# Prompts. Use langfuse everywhere shared; file prompts are for local work only.
ASAS_PROMPT_PROVIDER=langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Models
OPENAI_API_KEY=
# Optional: an OpenAI-compatible gateway, for example the AI Factory model gateway
MODEL_GATEWAY_URL=
MODEL_GATEWAY_KEY=
