# Agent registry
DATABASE_URL=postgresql://user@localhost:5432/asas_agent
ASAS_ENVIRONMENT=dev
# Optional comma-separated application modules that register tools/schemas/guardrails.
# Loaded before CLI publication and runtime startup.
ASAS_REGISTRATION_MODULES=

# Runtime API. Callers send it as `X-API-Key`.
ASAS_API_KEY=
ASAS_PORT=8080

# Prompts: file needs no extra service; publishing stores a snapshot in Postgres.
# Use langfuse to resolve prompts from a self-hosted instance or Langfuse Cloud.
ASAS_PROMPT_PROVIDER=file
ASAS_PROMPT_DIR=prompts

# Ceiling on the prompt variables one request may send.
ASAS_PROMPT_VARIABLES_MAX_BYTES=256000


# Optional tracing, independent of the prompt provider: none or langfuse.
ASAS_TRACING_PROVIDER=none
ASAS_TRACING=true

# Only needed when a provider above is langfuse. Install asas-agent[langfuse].
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Set this to your internal/self-hosted URL when not using Langfuse Cloud.
LANGFUSE_HOST=https://cloud.langfuse.com

# Models
OPENAI_API_KEY=
# Optional: an OpenAI-compatible gateway, for example the AI Factory model gateway
MODEL_GATEWAY_URL=
MODEL_GATEWAY_KEY=
